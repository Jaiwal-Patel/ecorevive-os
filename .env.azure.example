# ---------------------------------------------------------
# EcoRevive OS — Azure production environment template
# ---------------------------------------------------------
#
# Copy this file on the Azure VM:
#
#   cp .env.azure.example .env.azure
#   chmod 600 .env.azure
#
# Replace every value beginning with CHANGE_ME or YOUR_.
# Never commit .env.azure to GitHub.
# ---------------------------------------------------------

COMPOSE_PROJECT_NAME=ecorevive-azure

# ---------------------------------------------------------
# Public URLs
# ---------------------------------------------------------

# Azure VM public DNS hostname, without https://
#
# Example:
# ecorevive-api-jaiwal.uaenorth.cloudapp.azure.com
ECOREVIVE_DOMAIN=YOUR_AZURE_VM_FQDN

# Azure Static Web Apps production URL, including https://
#
# Example:
# https://green-tree-012345678.1.azurestaticapps.net
FRONTEND_ORIGIN=https://YOUR_STATIC_WEB_APP.azurestaticapps.net

# ---------------------------------------------------------
# Django
# ---------------------------------------------------------

DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=false

DJANGO_ALLOWED_HOSTS=YOUR_AZURE_VM_FQDN

DJANGO_CSRF_TRUSTED_ORIGINS=https://YOUR_AZURE_VM_FQDN,https://YOUR_STATIC_WEB_APP.azurestaticapps.net

DJANGO_CORS_ALLOWED_ORIGINS=https://YOUR_STATIC_WEB_APP.azurestaticapps.net

DJANGO_SECURE_SSL_REDIRECT=true

# Begin with one hour while testing.
# Increase to 31536000 after HTTPS is confirmed stable.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_PRELOAD=false

DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------
# Azure Database for PostgreSQL Flexible Server
# ---------------------------------------------------------

# Example:
# psql-ecorevive-prod.postgres.database.azure.com
POSTGRES_HOST=YOUR_AZURE_POSTGRES_HOST

POSTGRES_PORT=5432
POSTGRES_DB=ecorevive

# Use the dedicated application database user.
POSTGRES_USER=ecorevive_app
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_DATABASE_PASSWORD

POSTGRES_SSLMODE=require
POSTGRES_CONN_MAX_AGE=60

# ---------------------------------------------------------
# Redis
# ---------------------------------------------------------
#
# Redis runs privately inside Docker on the Azure VM.
# It must not be exposed publicly.
# ---------------------------------------------------------

REDIS_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_GENERATE_A_STRONG_REDIS_PASSWORD@redis:6379/0

REDIS_MAXMEMORY=128mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ---------------------------------------------------------
# Gunicorn and Celery
# ---------------------------------------------------------
#
# Conservative values for a Standard_B1s VM with 1 GB RAM.
# ---------------------------------------------------------

GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=90

CELERY_CONCURRENCY=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# ---------------------------------------------------------
# EcoRevive organization
# ---------------------------------------------------------

FOUNDER_EMAIL=ujaiwal@outlook.com
FOUNDER_FULL_NAME=Jaiwal Patel

FOUNDER_RECOVERY_EMAIL=
FOUNDER_RECOVERY_FULL_NAME=EcoRevive Founder Recovery

ORGANIZATION_NAME=EcoRevive Dubai
PROJECT_NAME=EcoRevive OS

SERVICE_CITY=Dubai
SERVICE_COUNTRY=United Arab Emirates

PUBLIC_SITE_URL=https://sites.google.com/view/ecorevive-dubai/home
PUBLIC_TAGLINE=Today's Actions. Tomorrow's Impact.

# ---------------------------------------------------------
# Transactional email
# ---------------------------------------------------------
#
# Use the console backend during the first Azure smoke test.
# Emails will appear in the Celery worker logs.
#
# After selecting an SMTP provider, replace EMAIL_BACKEND
# with:
#
# django.core.mail.backends.smtp.EmailBackend
#
# and configure the SMTP values below.
# ---------------------------------------------------------

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

DEFAULT_FROM_EMAIL=EcoRevive Dubai <no-reply@example.invalid>

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=30

# ---------------------------------------------------------
# WhatsApp
# ---------------------------------------------------------

WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=vXX.X
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

WHATSAPP_TEMPLATE_STATUS_UPDATED=ecorevive_status_updated
WHATSAPP_TEMPLATE_LANGUAGE=en_US
